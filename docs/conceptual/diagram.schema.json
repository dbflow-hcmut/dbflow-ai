{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "$id": "https://example.com/conceptual/diagram.schema.json",
  "title": "Conceptual ER/EER Diagram",
  "description": "Conceptual diagram nodes, edges, layout, and rendering metadata.",
  "type": "object",
  "additionalProperties": false,
  "required": ["diagram"],
  "properties": {
    "diagram": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes", "edges"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string"},
        "viewport": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "x": {"type": "number"},
            "y": {"type": "number"},
            "zoom": {"type": "number", "minimum": 0.1, "maximum": 5.0},
            "gridSize": {"type": "integer", "minimum": 2},
            "snapToGrid": {"type": "boolean"}
          }
        },
        "nodes": {
          "type": "array",
          "items": {"$ref": "#/$defs/node"}
        },
        "edges": {
          "type": "array",
          "items": {"$ref": "#/$defs/edge"}
        }
      }
    }
  },
  "$defs": {
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": {"type": "number"},
        "y": {"type": "number"}
      }
    },
    "size": {
      "type": "object",
      "additionalProperties": false,
      "required": ["w", "h"],
      "properties": {
        "w": {"type": "number", "minimum": 20},
        "h": {"type": "number", "minimum": 20}
      }
    },
    "node": {
      "description": "A visual node on the canvas.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "position", "size"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {
          "type": "string",
          "enum": ["entity", "relationship", "attribute", "isaCircle", "unionCircle", "note", "sticky-note", "text-label", "drawing-path"]
        },
        "position": {"$ref": "#/$defs/point"},
        "size": {"$ref": "#/$defs/size"},
        "zIndex": {"type": "integer", "minimum": 0},
        "style": {
          "description": "Visual styling. May include a 'meta' object for entity/relationship/attribute rendering hints.",
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "class": {"type": "string"},
            "stroke": {
              "type": ["string", "null"]
            },
            "fill": {
              "type": ["string", "null"]
            },
            "meta": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "entity": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "variant": {
                      "type": "string",
                      "enum": ["single", "double", "dashed"]
                    },
                    "fields": {"type": "array"}
                  }
                },
                "relationship": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "variant": {
                      "type": "string",
                      "enum": ["single", "double", "dashed"]
                    },
                    "cardinalities": {
                      "type": "object",
                      "additionalProperties": {"type": "string"}
                    }
                  }
                },
                "attribute": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "variant": {
                      "type": "string",
                      "enum": ["single", "double", "dashed"]
                    },
                    "isKey": {"type": "boolean"}
                  }
                }
              }
            }
          }
        },
        "name": {"type": "string"},
        "entityId": {"type": "string", "minLength": 1},
        "entityRender": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "doubleStroke": {"type": "boolean"}
          }
        },
        "relationshipId": {"type": "string", "minLength": 1},
        "relationshipRender": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "doubleStroke": {"type": "boolean"}
          }
        },
        "attributeId": {"type": "string", "minLength": 1},
        "attributeRender": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "doubleEllipse": {"type": "boolean"},
            "dashed": {"type": "boolean"},
            "underline": {"type": "boolean"},
            "underlineStyle": {
              "type": "string",
              "enum": ["solid", "dashed"],
              "default": "solid"
            }
          }
        },
        "isaCircle": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "symbol": {
              "type": "string",
              "enum": ["d", "o"],
              "default": "d"
            }
          }
        },
        "unionCircle": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "symbol": {
              "type": "string",
              "enum": ["U"],
              "default": "U"
            },
            "categoryId": {"type": "string", "minLength": 1}
          }
        },
        "text": {"type": "string"},
        "data": {"type": "object", "additionalProperties": true, "description": "Annotation data or persisted physical table column/index data."},
        "fields": {
          "type": "array",
          "items": {"type": "object", "additionalProperties": true}
        },
        "columns": {
          "type": "array",
          "items": {"type": "object", "additionalProperties": true}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {"const": "entity"}
            }
          },
          "then": {
            "required": ["entityId"]
          }
        },
        {
          "if": {
            "properties": {
              "type": {"const": "relationship"}
            }
          },
          "then": {
            "required": ["relationshipId"]
          }
        },
        {
          "if": {
            "properties": {
              "type": {"const": "attribute"}
            }
          },
          "then": {
            "required": ["attributeId"]
          }
        },
        {
          "if": {
            "properties": {
              "type": {"const": "isaCircle"}
            }
          },
          "then": {
            "required": ["isaCircle"]
          }
        },
        {
          "if": {
            "properties": {
              "type": {"const": "unionCircle"}
            }
          },
          "then": {
            "required": ["unionCircle"]
          }
        },
        {
          "if": {
            "properties": {
              "type": {"const": "note"}
            }
          },
          "then": {
            "required": ["text"]
          }
        }
      ]
    },
    "edge": {
      "description": "A connection between two diagram nodes.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "from", "to"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {
          "type": "string",
          "enum": ["participation", "attrOf", "componentOf", "identifying", "isaParent", "isaChild", "categoryLink", "categoryMember"]
        },
        "relationshipId": {"type": "string", "minLength": 1},
        "generalizationId": {"type": "string", "minLength": 1},
        "categoryId": {"type": "string", "minLength": 1},
        "from": {
          "type": "object",
          "additionalProperties": false,
          "required": ["nodeId"],
          "properties": {
            "nodeId": {"type": "string", "minLength": 1},
            "portId": {
              "type": "string",
              "enum": ["top", "bottom", "left", "right"]
            }
          }
        },
        "to": {
          "type": "object",
          "additionalProperties": false,
          "required": ["nodeId"],
          "properties": {
            "nodeId": {"type": "string", "minLength": 1},
            "portId": {
              "type": "string",
              "enum": ["top", "bottom", "left", "right"]
            }
          }
        },
        "labels": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "nearFrom": {"type": "string"},
            "center": {"type": "string"},
            "nearTo": {"type": "string"}
          }
        },
        "endStyle": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "from": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "doubleLine": {"type": "boolean"},
                "marker": {
                  "type": "string",
                  "enum": ["none", "one", "many"],
                  "default": "none"
                },
                "bracket": {"type": "boolean"}
              }
            },
            "to": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "doubleLine": {"type": "boolean"},
                "marker": {
                  "type": "string",
                  "enum": ["none", "one", "many"],
                  "default": "none"
                },
                "bracket": {"type": "boolean"}
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {"const": "participation"}
            }
          },
          "then": {
            "required": ["relationshipId"]
          }
        },
        {
          "if": {
            "properties": {
              "type": {"const": "identifying"}
            }
          },
          "then": {
            "required": ["relationshipId"]
          }
        },
        {
          "if": {
            "properties": {
              "type": {"const": "isaParent"}
            }
          },
          "then": {
            "required": ["generalizationId"]
          }
        },
        {
          "if": {
            "properties": {
              "type": {"const": "isaChild"}
            }
          },
          "then": {
            "required": ["generalizationId"]
          }
        },
        {
          "if": {
            "properties": {
              "type": {"const": "categoryLink"}
            }
          },
          "then": {
            "required": ["categoryId"]
          }
        },
        {
          "if": {
            "properties": {
              "type": {"const": "categoryMember"}
            }
          },
          "then": {
            "required": ["categoryId"]
          }
        }
      ]
    }
  }
}
