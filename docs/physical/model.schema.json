{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "$id": "https://example.com/physical/physical.schema.json",
  "title": "Physical Relational Schema",
  "description": "Physical relational schema with concrete data types, indexes, and FK constraints.",
  "type": "object",
  "additionalProperties": false,
  "required": ["model", "tables"],
  "properties": {
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version"],
      "properties": {
        "id": { "type": "string", "pattern": "^pid_" },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 1 },
        "notes": { "type": "string" }
      }
    },
    "tables": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/table" }
    }
  },
  "$defs": {
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "columns"],
      "properties": {
        "id": { "type": "string", "pattern": "^pid_" },
        "name": { "type": "string", "minLength": 1 },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/column" }
        },
        "indexes": {
          "type": "array",
          "items": { "$ref": "#/$defs/index" }
        },
        "notes": { "type": "string" }
      }
    },
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "dataType"],
      "properties": {
        "id": { "type": "string", "pattern": "^pid_" },
        "name": { "type": "string", "minLength": 1 },
        "dataType": {
          "type": "string",
          "minLength": 1,
          "description": "Base SQL type without length, e.g. 'varchar', 'integer', 'decimal'."
        },
        "length": {
          "type": "string",
          "description": "Length or precision, e.g. '255' for varchar(255), '10,2' for decimal(10,2)."
        },
        "nullable": { "type": "boolean", "default": true },
        "unique": { "type": "boolean", "default": false },
        "autoIncrement": {
          "type": "boolean",
          "default": false,
          "description": "Whether this column auto-increments (e.g. SERIAL, AUTO_INCREMENT, IDENTITY)."
        },
        "defaultValue": {
          "type": "string",
          "description": "SQL default value expression, e.g. 'NOW()', '0', 'true'."
        },
        "roles": { "$ref": "#/$defs/roles" },
        "notes": { "type": "string" }
      }
    },
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "primaryKey": { "type": "boolean" },
        "foreignKey": { "$ref": "#/$defs/foreignKey" },
        "candidateKey": { "type": "boolean" }
      }
    },
    "foreignKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["refTableId", "refColumnId"],
      "properties": {
        "refTableId": { "type": "string", "pattern": "^pid_" },
        "refColumnId": { "type": "string", "pattern": "^pid_" },
        "onDelete": {
          "type": "string",
          "enum": ["NO ACTION", "CASCADE", "SET NULL", "SET DEFAULT", "RESTRICT"],
          "default": "NO ACTION"
        },
        "onUpdate": {
          "type": "string",
          "enum": ["NO ACTION", "CASCADE", "SET NULL", "SET DEFAULT", "RESTRICT"],
          "default": "NO ACTION"
        }
      }
    },
    "index": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "type", "columns"],
      "properties": {
        "id": { "type": "string" },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Index name, e.g. 'idx_customer_email'."
        },
        "type": {
          "type": "string",
          "enum": ["BTREE", "HASH", "GIN", "GIST", "BRIN"],
          "default": "BTREE"
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["columnName", "order"],
            "properties": {
              "columnName": { "type": "string", "minLength": 1 },
              "order": {
                "type": "string",
                "enum": ["ASC", "DESC"],
                "default": "ASC"
              }
            }
          }
        },
        "isUnique": { "type": "boolean", "default": false }
      }
    }
  }
}
