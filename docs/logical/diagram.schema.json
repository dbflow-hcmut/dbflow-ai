{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "$id": "https://example.com/logical/diagram.schema.json",
  "title": "Logical Relational Diagram",
  "type": "object",
  "additionalProperties": false,
  "required": ["diagram"],
  "properties": {
    "diagram": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes", "edges"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string"},
        "viewport": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "x": {"type": "number"},
            "y": {"type": "number"},
            "zoom": {"type": "number", "minimum": 0.1, "maximum": 5.0},
            "gridSize": {"type": "integer", "minimum": 2},
            "snapToGrid": {"type": "boolean"}
          }
        },
        "nodes": {
          "type": "array",
          "items": {"$ref": "#/$defs/node"}
        },
        "edges": {
          "type": "array",
          "items": {"$ref": "#/$defs/edge"}
        }
      }
    }
  },
  "$defs": {
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": {"type": "number"},
        "y": {"type": "number"}
      }
    },
    "size": {
      "type": "object",
      "additionalProperties": false,
      "required": ["w", "h"],
      "properties": {
        "w": {"type": "number", "minimum": 20},
        "h": {"type": "number", "minimum": 20}
      }
    },
    "style": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "class": {"type": "string"},
        "stroke": {
          "type": ["string", "null"]
        },
        "fill": {
          "type": ["string", "null"]
        },
        "fontSize": {"type": "number"}
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "position", "size"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {
          "type": "string",
          "enum": ["table", "note", "sticky-note", "text-label", "drawing-path"]
        },
        "position": {"$ref": "#/$defs/point"},
        "size": {"$ref": "#/$defs/size"},
        "zIndex": {"type": "integer", "minimum": 0},
        "style": {"$ref": "#/$defs/style"},
        "name": {"type": "string"},
        "tableId": {"type": "string", "minLength": 1},
        "columns": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["columnId"],
            "properties": {
              "columnId": {"type": "string", "minLength": 1},
              "label": {"type": "string"},
              "decorations": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "pk": {"type": "boolean", "default": false},
                  "ck": {"type": "boolean", "default": false},
                  "fk": {"type": "boolean", "default": false},
                  "underline": {"type": "boolean", "description": "Legacy decoration."},
                  "italic": {"type": "boolean", "description": "Legacy decoration."}
                }
              }
            }
          }
        },
        "text": {"type": "string"},
        "data": {"type": "object", "additionalProperties": true, "description": "Annotation data or persisted physical table column/index data."}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {"const": "table"}
            }
          },
          "then": {
            "required": ["tableId"]
          }
        }
      ]
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "source", "target"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {
          "type": "string",
          "enum": ["fk", "noteLink"]
        },
        "source": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1},
        "sourceSide": {
          "type": "string",
          "enum": ["left", "right"]
        },
        "targetSide": {
          "type": "string",
          "enum": ["left", "right"]
        },
        "points": {
          "type": "array",
          "items": {"$ref": "#/$defs/point"}
        },
        "style": {"$ref": "#/$defs/style"},
        "fkRef": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tableId": {"type": "string", "minLength": 1},
            "foreignKeyIndex": {"type": "integer", "minimum": 0}
          }
        },
        "labels": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "text": {"type": "string"},
            "position": {"$ref": "#/$defs/point"}
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {"const": "fk"}
            }
          },
          "then": {
            "required": ["fkRef"]
          }
        }
      ]
    }
  }
}
