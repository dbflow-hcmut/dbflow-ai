{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "$id": "https://example.com/logical/model.schema.json",
  "title": "Logical Relational Schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["model", "tables"],
  "properties": {
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "integer", "minimum": 1},
        "notes": {"type": "string"}
      }
    },
    "tables": {
      "type": "array",
      "items": {"$ref": "#/$defs/table"}
    }
  },
  "$defs": {
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "columns"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string"},
        "columns": {
          "type": "array",
          "items": {"$ref": "#/$defs/column"}
        },
        "functionalDependencies": {
          "type": "array",
          "items": {"$ref": "#/$defs/functionalDependency"}
        },
        "showFunctionalDependencies": {"type": "boolean", "default": false},
        "notes": {"type": "string"}
      }
    },
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string"},
        "nullable": {"type": "boolean", "default": true},
        "unique": {"type": "boolean", "default": false},
        "roles": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "primaryKey": {"type": "boolean", "default": false},
            "foreignKey": {
              "type": "object",
              "additionalProperties": false,
              "required": ["refTableId", "refColumnId"],
              "properties": {
                "refTableId": {"type": "string", "minLength": 1},
                "refColumnId": {"type": "string", "minLength": 1}
              }
            },
            "candidateKey": {"type": "boolean", "default": false}
          }
        },
        "notes": {"type": "string"},
        "type": {"type": "string", "description": "Legacy logical type hint; omit in new output."}
      }
    },
    "functionalDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["left", "right"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "description": "Stable FD identifier; include in new output. Older payloads may omit it."},
        "name": {"type": "string"},
        "left": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "right": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "notes": {"type": "string"}
      }
    }
  }
}
