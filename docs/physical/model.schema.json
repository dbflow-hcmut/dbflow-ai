{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "$id": "https://example.com/physical/physical.schema.json",
  "title": "Physical Database Schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["physical"],
  "properties": {
    "physical": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "dbms", "version", "databases"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^phid_"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "dbms": {
          "$ref": "#/$defs/dbms"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "defaultDatabase": {
          "type": "string"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "createdBy": {
              "type": "string"
            },
            "createdAt": {
              "type": "string",
              "format": "date-time"
            },
            "updatedBy": {
              "type": "string"
            },
            "updatedAt": {
              "type": "string",
              "format": "date-time"
            },
            "sourceHash": {
              "type": "string"
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "source": {
          "$ref": "#/$defs/sourceInfo"
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/warning"
          }
        },
        "databases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/database"
          }
        }
      }
    }
  },
  "$defs": {
    "dbms": {
      "type": "string",
      "enum": [
        "postgres",
        "mysql",
        "mariadb",
        "sqlserver",
        "oracle",
        "sqlite",
        "bigquery",
        "snowflake",
        "db2",
        "other"
      ]
    },

    "logicalMappable": {
      "description": "Flag cho biết object này có thể map sang logical/ERD không.",
      "type": ["string", "boolean"],
      "enum": [true, false, "always", "never", "candidate"]
    },

    "sourceInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["ddl_script", "live_connection", "other"]
        },
        "dialectDetected": {
          "$ref": "#/$defs/dbms"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path"],
            "properties": {
              "path": {
                "type": "string"
              },
              "hash": {
                "type": "string"
              },
              "size": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "connection": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "host": {
              "type": "string"
            },
            "port": {
              "type": "integer"
            },
            "database": {
              "type": "string"
            },
            "user": {
              "type": "string"
            }
          }
        }
      }
    },

    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity"],
      "properties": {
        "code": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": ["info", "warning", "error"]
        },
        "message": {
          "type": "string"
        },
        "location": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "file": {
              "type": "string"
            },
            "line": {
              "type": "integer",
              "minimum": 1
            },
            "statementId": {
              "type": "string"
            }
          }
        },
        "objectRef": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "database",
                "schema",
                "table",
                "view",
                "column",
                "constraint",
                "index",
                "sequence",
                "trigger",
                "function",
                "other"
              ]
            },
            "database": {
              "type": "string"
            },
            "schema": {
              "type": "string"
            },
            "table": {
              "type": "string"
            },
            "column": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          }
        }
      }
    },

    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "schemas"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^phid_db_"
        },
        "name": {
          "type": "string"
        },
        "comment": {
          "type": "string"
        },
        "schemas": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dbSchema"
          }
        }
      }
    },

    "dbSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^phid_schema_"
        },
        "name": {
          "type": "string"
        },
        "comment": {
          "type": "string"
        },
        "tables": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/table"
          }
        },
        "views": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/view"
          }
        },
        "sequences": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sequence"
          }
        },
        "triggers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/trigger"
          }
        },
        "functions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/function"
          }
        }
      }
    },

    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "columns"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^phid_table_"
        },
        "name": {
          "type": "string"
        },
        "comment": {
          "type": "string"
        },
        "columns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/column"
          }
        },
        "primaryKey": {
          "$ref": "#/$defs/primaryKey"
        },
        "uniqueConstraints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/uniqueConstraint"
          }
        },
        "foreignKeys": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/foreignKey"
          }
        },
        "checkConstraints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/checkConstraint"
          }
        },
        "indexes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/index"
          }
        },
        "partitioning": {
          "$ref": "#/$defs/partitioning"
        },
        "storage": {
          "$ref": "#/$defs/storageOptions"
        },
        "options": {
          "type": "object",
          "additionalProperties": true
        },
        "source": {
          "$ref": "#/$defs/objectSource"
        },
        "logicalMappable": {
          "$ref": "#/$defs/logicalMappable"
        }
      }
    },

    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "dataTypeOriginal"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^phid_col_"
        },
        "name": {
          "type": "string"
        },
        "position": {
          "type": "integer",
          "minimum": 1
        },
        "dataTypeOriginal": {
          "type": "string"
        },
        "dataTypeNormalized": {
          "type": "string"
        },
        "length": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "precision": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "scale": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "nullable": {
          "type": "boolean"
        },
        "default": {
          "type": ["string", "number", "boolean", "null"]
        },
        "isIdentity": {
          "type": "boolean"
        },
        "isGenerated": {
          "type": "boolean"
        },
        "collation": {
          "type": ["string", "null"]
        },
        "comment": {
          "type": "string"
        },
        "physicalOnly": {
          "type": "boolean",
          "default": false
        },
        "logicalMappable": {
          "$ref": "#/$defs/logicalMappable"
        },
        "vendorSpecific": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },

    "primaryKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "columns"],
      "properties": {
        "name": {
          "type": "string"
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "deferrable": {
          "type": "boolean"
        },
        "initiallyDeferred": {
          "type": "boolean"
        },
        "logicalMappable": {
          "$ref": "#/$defs/logicalMappable"
        }
      }
    },

    "uniqueConstraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "columns"],
      "properties": {
        "name": {
          "type": "string"
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "logicalMappable": {
          "$ref": "#/$defs/logicalMappable"
        }
      }
    },

    "foreignKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "columns", "refTable", "refColumns"],
      "properties": {
        "name": {
          "type": "string"
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "refSchema": {
          "type": "string"
        },
        "refTable": {
          "type": "string"
        },
        "refColumns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "onDelete": {
          "type": "string"
        },
        "onUpdate": {
          "type": "string"
        },
        "deferrable": {
          "type": "boolean"
        },
        "initiallyDeferred": {
          "type": "boolean"
        },
        "logicalMappable": {
          "$ref": "#/$defs/logicalMappable"
        }
      }
    },

    "checkConstraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "expression"],
      "properties": {
        "name": {
          "type": "string"
        },
        "expression": {
          "type": "string"
        },
        "logicalMappable": {
          "$ref": "#/$defs/logicalMappable"
        }
      }
    },

    "index": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "columns"],
      "properties": {
        "name": {
          "type": "string"
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "unique": {
          "type": "boolean"
        },
        "method": {
          "type": "string"
        },
        "wherePredicate": {
          "type": "string"
        },
        "includedColumns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "logicalMappable": {
          "$ref": "#/$defs/logicalMappable"
        },
        "vendorSpecificFlags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },

    "partitioning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy"],
      "properties": {
        "strategy": {
          "type": "string",
          "enum": ["RANGE", "LIST", "HASH", "OTHER"]
        },
        "expression": {
          "type": "string"
        },
        "partitions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": {
                "type": "string"
              },
              "from": {
                "type": ["string", "null"]
              },
              "to": {
                "type": ["string", "null"]
              },
              "values": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "tablespace": {
                "type": "string"
              }
            }
          }
        },
        "logicalMappable": {
          "$ref": "#/$defs/logicalMappable"
        }
      }
    },

    "storageOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tablespace": {
          "type": "string"
        },
        "filegroup": {
          "type": "string"
        },
        "fillfactor": {
          "type": "integer"
        },
        "compression": {
          "type": "string"
        },
        "other": {
          "type": "object",
          "additionalProperties": true
        },
        "logicalMappable": {
          "$ref": "#/$defs/logicalMappable"
        }
      }
    },

    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "definition"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^phid_view_"
        },
        "name": {
          "type": "string"
        },
        "comment": {
          "type": "string"
        },
        "definition": {
          "type": "string"
        },
        "baseTables": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "isMaterialized": {
          "type": "boolean"
        },
        "storage": {
          "$ref": "#/$defs/storageOptions"
        },
        "logicalMappable": {
          "$ref": "#/$defs/logicalMappable"
        },
        "source": {
          "$ref": "#/$defs/objectSource"
        }
      }
    },

    "sequence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^phid_seq_"
        },
        "name": {
          "type": "string"
        },
        "increment": {
          "type": "integer"
        },
        "minValue": {
          "type": "integer"
        },
        "maxValue": {
          "type": "integer"
        },
        "startValue": {
          "type": "integer"
        },
        "cache": {
          "type": "integer"
        },
        "cycle": {
          "type": "boolean"
        },
        "logicalMappable": {
          "$ref": "#/$defs/logicalMappable"
        },
        "source": {
          "$ref": "#/$defs/objectSource"
        }
      }
    },

    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "table", "timing", "events"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^phid_trg_"
        },
        "name": {
          "type": "string"
        },
        "table": {
          "type": "string"
        },
        "schema": {
          "type": "string"
        },
        "timing": {
          "type": "string",
          "enum": ["BEFORE", "AFTER", "INSTEAD OF", "UNKNOWN"]
        },
        "events": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["INSERT", "UPDATE", "DELETE", "TRUNCATE", "UNKNOWN"]
          }
        },
        "function": {
          "type": "string"
        },
        "definition": {
          "type": "string"
        },
        "logicalMappable": {
          "$ref": "#/$defs/logicalMappable"
        },
        "source": {
          "$ref": "#/$defs/objectSource"
        }
      }
    },

    "function": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^phid_func_"
        },
        "name": {
          "type": "string"
        },
        "schema": {
          "type": "string"
        },
        "returnType": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "isDeterministic": {
          "type": "boolean"
        },
        "body": {
          "type": "string"
        },
        "logicalMappable": {
          "$ref": "#/$defs/logicalMappable"
        },
        "source": {
          "$ref": "#/$defs/objectSource"
        }
      }
    },

    "objectSource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ddlFragment": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "statementId": {
          "type": "string"
        }
      }
    }
  }
}
